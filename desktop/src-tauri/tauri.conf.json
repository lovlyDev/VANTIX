{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VANTIX",
  "version": "0.1.0",
  "identifier": "app.vantix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VANTIX",
      "width": 1140,
      "height": 760,
      "minWidth": 880,
      "minHeight": 640,
      "backgroundColor": "#000000"
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/vantix"],
    "resources": {
      "../../data/ton-english.txt": "data/ton-english.txt",
      "../../gpu/vulkan/derive.spv": "gpu/vulkan/derive.spv"
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjA5MUY2OUUxQ0U1RTkKUldUcDVSeWU5cEd3R2FQekNBNGVMNzhHMFRka1E2L2x3a3hCRFo5TU81OHpPSENuWXF2Lzd3NWUK",
      "endpoints": ["https://github.com/lovlyDev/VANTIX/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
